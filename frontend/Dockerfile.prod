FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

# NEXT_PUBLIC_* se incrusta en el bundle en build, no en runtime.
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN npm run build

# Usuario no-root.
RUN chown -R node:node /app
USER node

EXPOSE 3000

CMD ["npm", "start"]
