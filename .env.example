# Copia este archivo a .env y rellena valores reales. NUNCA subas .env al repo.

# Entorno: development | production
# En production la API valida que los secretos y hosts esten bien configurados.
APP_ENV=development

# Base de datos (usada por Postgres y por la API)
POSTGRES_PASSWORD=cambia-esta-clave-db

# Secretos JWT. Deben ser fuertes y DISTINTOS entre si. Genera con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=cambia-este-secreto-jwt
JWT_REFRESH_SECRET_KEY=cambia-este-secreto-refresh

# Admin sembrado en el primer arranque.
# Si SEED_ADMIN_PASSWORD queda vacio, la API genera una contrasena aleatoria
# y la imprime UNA sola vez en los logs al crear el usuario.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# --- Solo produccion (docker-compose.prod.yml) ---

# Dominio publico (sin protocolo). Ej: erp.midominio.com
DOMAIN=

# Origenes permitidos para CORS (lista separada por comas, con protocolo).
# Ej: https://erp.midominio.com
CORS_ORIGINS=

# Hosts permitidos (TrustedHost, lista separada por comas, sin protocolo).
# Ej: erp.midominio.com
ALLOWED_HOSTS=

# Documentacion /docs. Debe ser false en produccion.
ENABLE_DOCS=false

# Creacion automatica de tablas. Poner false cuando exista Alembic (Fase 3).
AUTO_CREATE_TABLES=true
