# Copia este archivo a .env y rellena valores reales. NUNCA subas .env al repo.

# Entorno: development | production
# En production la API valida que los secretos y hosts esten bien configurados.
APP_ENV=development

# Base de datos (usada por Postgres y por la API)
POSTGRES_PASSWORD=cambia-esta-clave-db

# Secretos JWT. Deben ser fuertes y DISTINTOS entre si. Genera con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=cambia-este-secreto-jwt
JWT_REFRESH_SECRET_KEY=cambia-este-secreto-refresh

# Admin creado en el arranque (siempre, en cualquier entorno, idempotente).
# Si SEED_ADMIN_PASSWORD queda vacio, la API genera una contrasena aleatoria
# y la imprime UNA sola vez en los logs al crear el usuario.
# En produccion SEED_ADMIN_PASSWORD es OBLIGATORIO (la API no arranca sin el).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# Si el admin YA existe, su clave no se toca en cada arranque. Para forzar que
# tome de nuevo el valor de SEED_ADMIN_PASSWORD, pon esto en true una vez,
# arranca, y luego vuelvelo a false.
SEED_ADMIN_RESET_ON_BOOT=false

# Dominio de los correos generados por el sistema (lo que va despues del @).
SYSTEM_EMAIL_DOMAIN=fenixglobal.online

# --- Solo produccion (docker-compose.prod.yml) ---

# Dominio publico (sin protocolo). Ej: erp.midominio.com
DOMAIN=

# Origenes permitidos para CORS (lista separada por comas, con protocolo).
# Ej: https://erp.midominio.com
CORS_ORIGINS=

# Hosts permitidos (TrustedHost, lista separada por comas, sin protocolo).
# Ej: erp.midominio.com
ALLOWED_HOSTS=

# Documentacion /docs. Debe ser false en produccion.
ENABLE_DOCS=false

# Creacion automatica de tablas (create_all). Dejar false: el esquema lo
# gestiona Alembic (docker corre "alembic upgrade head" al arrancar).
AUTO_CREATE_TABLES=false

# Siembra datos de EJEMPLO (procesos y catalogo) al arrancar. El admin se crea
# siempre aparte. true en desarrollo; false en produccion (base limpia).
SEED_ON_STARTUP=false

# Backup automatico de PostgreSQL (servicio db-backup): cada cuantas horas
# respalda y cuantos dias conserva los dumps en ./backups/. Default 24h /
# 30 dias en produccion.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
